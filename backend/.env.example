# Database Configuration
DATABASE_URL=postgresql://edupath:edupath_secret_password@localhost:5432/edupath
# Fallback local SQLite if PostgreSQL is not active
FALLBACK_SQLITE_URL=sqlite:///./edupath.db

# JWT Security
JWT_SECRET_KEY=edupath_super_secret_jwt_key_hackathon_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini API (Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Upload Directory
UPLOAD_DIR=./uploads
